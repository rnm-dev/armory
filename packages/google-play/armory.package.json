{
  "schemaVersion": 1,
  "id": "google-play",
  "version": "0.1.1",
  "minPeonVersion": "0.0.1",
  "platforms": [
    { "os": "darwin", "arch": "arm64" },
    { "os": "darwin", "arch": "x64" },
    { "os": "linux", "arch": "arm64" },
    { "os": "linux", "arch": "x64" }
  ],
  "permissions": {
    "networkHosts": ["androidpublisher.googleapis.com", "oauth2.googleapis.com"],
    "hostPaths": []
  },
  "dependencies": [],
  "configuration": {
    "fields": [
      {
        "id": "serviceAccountFile",
        "label": "Service account JSON",
        "help": "In Google Cloud Console, enable the Google Play Android Developer API and create a service account key in JSON format. In Play Console, grant that service account access to the app and the release permissions you want Peon to use, then select the downloaded JSON file here.",
        "type": "file",
        "required": true,
        "validation": { "maxLength": 1048576 }
      }
    ],
    "handler": { "executable": "node", "args": ["dist/hooks/configure.js"] },
    "verifyHandler": { "executable": "node", "args": ["dist/hooks/verify.js"] },
    "managedPaths": ["config/google-play.json"]
  },
  "mcp": {
    "command": { "executable": "node", "args": ["dist/mcp.js"] },
    "toolPrefix": "google_play",
    "startupTimeoutMs": 15000,
    "callTimeoutMs": 60000
  }
}
